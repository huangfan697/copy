.container {
  min-height: 100vh;
  background: #F5F5F7;
  padding: 24rpx;
}

.header-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  text-align: center;
}

.date-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  display: block;
  margin-bottom: 20rpx;
}

.stats-row {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #0D9488;
}

.stat-label {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #9CA3AF;
}

.section {
  margin-top: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.note-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.note-subject {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 12rpx;
}

.note-content {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.note-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.tag {
  display: inline-block;
  background: #F0FDFA;
  color: #0D9488;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

.empty {
  text-align: center;
  padding: 80rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}
