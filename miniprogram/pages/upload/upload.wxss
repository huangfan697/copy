.upload-area {
  background: #fff;
  border-radius: 16rpx;
  height: 600rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.preview {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.placeholder .icon {
  font-size: 120rpx;
  color: #D1D5DB;
}

.placeholder .hint {
  font-size: 28rpx;
  color: #9CA3AF;
}
