<view class="page">
  <!-- 顶部渐变背景 -->
  <view class="header-bg">
    <view class="greeting">
      <text class="greeting-text">早上好 👋</text>
      <text class="date-text">{{todayDate}}</text>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-row">
    <view class="stat-card">
      <text class="stat-value {{errorRateClass}}">{{todayErrorRate}}%</text>
      <text class="stat-label">今日错题率</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{todayTotal}}</text>
      <text class="stat-label">今日答题</text>
    </view>
    <view class="stat-card">
      <text class="stat-value streak">{{streakDays}}</text>
      <text class="stat-label">连续天数</text>
    </view>
  </view>

  <!-- 今日训练按钮 -->
  <view class="train-section">
    <view class="train-card" bindtap="onStartTrain">
      <view class="train-icon-wrap">
        <view class="train-icon">📝</view>
      </view>
      <view class="train-info">
        <text class="train-title">开始今日训练</text>
        <text class="train-desc">共 {{trainCount}} 道题</text>
        <text class="train-hint" wx:if="{{trainCount > 0}}">
          昨日错题 {{yesterdayWrong}} + 新导入 {{yesterdayNew}}
        </text>
        <text class="train-hint empty" wx:else>暂无题目，先去上传错题吧</text>
      </view>
      <view class="train-arrow">›</view>
    </view>
  </view>

  <!-- 最近错题 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">最近错题</text>
      <text class="section-more" bindtap="onGoUpload">去上传 +</text>
    </view>

    <view class="note-card" wx:for="{{notes}}" wx:key="id" bindtap="onNoteTap" data-id="{{item.id}}">
      <view class="note-subject">{{item.subject || '未分类'}}</view>
      <view class="note-content">{{item.rawContent}}</view>
      <view class="note-meta">
        <view class="note-tags">
          <text class="tag" wx:for="{{item.tagsList}}" wx:key="*this">{{item}}</text>
        </view>
        <text class="note-time">{{item.createdAt}}</text>
      </view>
    </view>

    <view class="empty" wx:if="{{notes.length === 0}}">
      <text>还没有错题，快去上传吧~</text>
    </view>
  </view>

  <!-- 每日栏目 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">每日栏目</text>
    </view>

    <view class="collection-card" wx:for="{{collections}}" wx:key="id" bindtap="onCollectionTap" data-id="{{item.id}}">
      <view class="collection-date">{{item.dateDisplay}}</view>
      <view class="collection-stats">
        <text class="stat">错题 {{item.noteCount}} 道</text>
        <text class="stat-divider">·</text>
        <text class="stat">练习 {{item.questionCount}} 道</text>
      </view>
      <view class="collection-arrow">›</view>
    </view>

    <view class="empty" wx:if="{{collections.length === 0}}">
      <text>还没有栏目，上传错题自动生成~</text>
    </view>
  </view>
</view>
