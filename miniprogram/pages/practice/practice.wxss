.progress-bar {
  height: 8rpx;
  background: #E5E7EB;
  border-radius: 4rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #4F46E5;
  border-radius: 4rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 24rpx;
  display: block;
}

.question-card {
  padding: 32rpx;
}

.question-text {
  font-size: 32rpx;
  color: #1F2937;
  line-height: 1.8;
  font-weight: 500;
}

.options-card {
  padding: 16rpx 32rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 20rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.option-item.selected {
  border-color: #4F46E5;
  background: #EEF2FF;
}

.option-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4F46E5;
  margin-right: 16rpx;
}

.option-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
  flex: 1;
}

.result-card {
  margin-top: 24rpx;
}

.result-header {
  font-size: 36rpx;
  font-weight: 600;
  padding: 16rpx 0;
  text-align: center;
}

.result-header.correct {
  color: #059669;
}

.result-header.wrong {
  color: #DC2626;
}

.result-detail {
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.result-detail text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}

.result-card .btn-primary {
  margin-top: 24rpx;
}

.result-card .result-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1F2937;
  display: block;
  margin-bottom: 16rpx;
}

.result-card .result-score {
  font-size: 32rpx;
  color: #4F46E5;
  display: block;
  margin-bottom: 8rpx;
}

.result-card .result-rate {
  font-size: 28rpx;
  color: #6B7280;
  display: block;
}
