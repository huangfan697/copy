.note-image {
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 16rpx;
}

.content-text, .analysis-text {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.8;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #14B8A6, #0D9488);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(13, 148, 136, 0.35);
  padding: 0;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #0D9488;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: 2rpx solid #99F6E4;
  padding: 0;
}

.btn-secondary::after {
  border: none;
}
