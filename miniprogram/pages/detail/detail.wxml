<view class="container" wx:if="{{note}}">
  <!-- 原图 -->
  <view class="card">
    <image class="note-image" src="{{note.imageUrl}}" mode="aspectFill" bindtap="onPreviewImage" />
  </view>

  <!-- 解析结果 -->
  <view class="card">
    <view class="section-title">题目内容</view>
    <text class="content-text">{{note.rawContent}}</text>
  </view>

  <view class="card">
    <view class="section-title">知识点</view>
    <view class="tags">
      <text class="tag" wx:for="{{tags}}" wx:key="*this">{{item}}</text>
    </view>
  </view>

  <view class="card">
    <view class="section-title">解题思路</view>
    <text class="analysis-text">{{note.analysis}}</text>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn-primary" bindtap="onGeneratePractice" wx:if="{{note.status !== 1}}">
      生成练习
    </button>
    <button class="btn-secondary" bindtap="onMarkMastered" wx:if="{{note.status !== 1}}">
      标记已掌握
    </button>
  </view>
</view>
